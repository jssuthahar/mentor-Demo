@{
    var title = ViewData["Title"] ?? "MentorApp";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@title - MentorApp</title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- Application CSS -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/account.css"
          asp-append-version="true" />

</head>


<body>


    <!-- ==========================================
         NAVBAR
         ========================================== -->

    <nav class="navbar navbar-expand-lg mentor-navbar">

        <div class="container">


            <!-- Logo -->

            <a class="navbar-brand mentor-logo"
               asp-controller="Home"
               asp-action="Index">

                <span class="logo-icon">
                    M
                </span>

                <span>
                    Mentor<span class="logo-highlight">App</span>
                </span>

            </a>


            <!-- Mobile Menu Button -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- Navigation -->

            <div class="collapse navbar-collapse"
                 id="mainNavbar">


                <!-- Main Menu -->

                <ul class="navbar-nav mx-auto">


                    <!-- Home -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            Home

                        </a>

                    </li>


                    <!-- Find Mentor -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Mentor"
                           asp-action="Index">

                            Find Mentor

                        </a>

                    </li>


                    <!-- Appointments -->

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Appointment"
                               asp-action="Index">

                                Appointments

                            </a>

                        </li>
                    }


                </ul>


                <!-- ==========================================
                     ACCOUNT SECTION
                     ========================================== -->

                <div class="d-flex align-items-center gap-2">


                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        <!-- ==================================
                             NOTIFICATION
                             ================================== -->

                        <button class="btn notification-btn"
                                type="button"
                                title="Notifications">

                            <i class="bi bi-bell"></i>

                            <span class="notification-dot"></span>

                        </button>


                        <!-- ==================================
                             PROFILE DROPDOWN
                             ================================== -->

                        <div class="dropdown">


                            <button class="btn profile-menu dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">


                                <!-- User Avatar -->

                                <span class="user-avatar">

                                    @(
                                        !string.IsNullOrEmpty(User.Identity?.Name)
                                            ? User.Identity.Name.Substring(0, 1).ToUpper()
                                            : "U"
                                    )

                                </span>


                                <!-- User Name -->

                                <span class="d-none d-lg-inline">

                                    @User.Identity?.Name

                                </span>


                            </button>


                            <!-- Dropdown -->

                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">


                                <!-- My Profile -->

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Profile"
                                       asp-action="Index">

                                        <i class="bi bi-person me-2"></i>

                                        My Profile

                                    </a>

                                </li>


                                <!-- Edit Profile -->

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Profile"
                                       asp-action="Edit">

                                        <i class="bi bi-pencil me-2"></i>

                                        Edit Profile

                                    </a>

                                </li>


                                <!-- Become Mentor -->

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Mentor"
                                       asp-action="BecomeMentor">

                                        <i class="bi bi-person-plus me-2"></i>

                                        Become a Mentor

                                    </a>

                                </li>


                                <!-- Divider -->

                                <li>

                                    <hr class="dropdown-divider" />

                                </li>


                                <!-- Logout -->

                                <li>

                                    <form asp-controller="Account"
                                          asp-action="Logout"
                                          method="post">

                                        <button type="submit"
                                                class="dropdown-item text-danger">

                                            <i class="bi bi-box-arrow-right me-2"></i>

                                            Logout

                                        </button>

                                    </form>

                                </li>


                            </ul>

                        </div>

                    }

                    else
                    {

                        <!-- ==================================
                             LOGIN
                             ================================== -->

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="layout-login-btn">

                            Login

                        </a>


                        <!-- ==================================
                             REGISTER
                             ================================== -->

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="layout-register-btn">

                            Create Account

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    }


                </div>

            </div>

        </div>

    </nav>


    <!-- ==========================================
         MAIN CONTENT
         ========================================== -->

    <main>

        @RenderBody()

    </main>


    <!-- ==========================================
         FOOTER
         ========================================== -->

    <footer class="mentor-footer">

        <div class="container">


            <div class="row gy-4">


                <!-- Brand -->

                <div class="col-lg-5">

                    <div class="footer-logo">

                        <span class="logo-icon">
                            M
                        </span>

                        <span>
                            MentorApp
                        </span>

                    </div>


                    <p class="footer-description">

                        Connect with experienced mentors,
                        share knowledge, and grow your career.

                    </p>

                </div>


                <!-- Platform -->

                <div class="col-6 col-lg-2">

                    <h6>
                        Platform
                    </h6>


                    <a asp-controller="Mentor"
                       asp-action="Index">

                        Find Mentor

                    </a>


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Appointment"
                           asp-action="Index">

                            Appointments

                        </a>
                    }


                    <a asp-controller="Mentor"
                       asp-action="BecomeMentor">

                        Become a Mentor

                    </a>

                </div>


                <!-- Account -->

                <div class="col-6 col-lg-2">

                    <h6>
                        Account
                    </h6>


                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        <a asp-controller="Profile"
                           asp-action="Index">

                            Profile

                        </a>


                        <a asp-controller="Profile"
                           asp-action="Edit">

                            Edit Profile

                        </a>

                    }
                    else
                    {

                        <a asp-controller="Account"
                           asp-action="Login">

                            Login

                        </a>


                        <a asp-controller="Account"
                           asp-action="Register">

                            Create Account

                        </a>


                        <a asp-controller="Account"
                           asp-action="ForgotPassword">

                            Forgot Password

                        </a>

                    }

                </div>


                <!-- Social -->

                <div class="col-lg-3">

                    <h6>
                        Follow Us
                    </h6>


                    <div class="social-links">


                        <a href="#"
                           aria-label="LinkedIn">

                            <i class="bi bi-linkedin"></i>

                        </a>


                        <a href="#"
                           aria-label="Facebook">

                            <i class="bi bi-facebook"></i>

                        </a>


                        <a href="#"
                           aria-label="Twitter">

                            <i class="bi bi-twitter-x"></i>

                        </a>


                        <a href="#"
                           aria-label="Instagram">

                            <i class="bi bi-instagram"></i>

                        </a>


                    </div>

                </div>


            </div>


            <!-- Divider -->

            <hr />


            <!-- Bottom -->

            <div class="footer-bottom">


                <span>

                    © 2026 MentorApp.
                    All rights reserved.

                </span>


                <div>

                    <a href="#">
                        Privacy
                    </a>


                    <a href="#">
                        Terms
                    </a>


                    <a href="#">
                        Help
                    </a>

                </div>


            </div>


        </div>

    </footer>


    <!-- ==========================================
         BOOTSTRAP JS
         ========================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- Page Scripts -->

    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>