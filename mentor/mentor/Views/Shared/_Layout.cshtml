@{
    var title = ViewData["Title"] ?? "MentorApp";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@title - MentorApp</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css" />

</head>

<body>

    <!-- Navbar -->

    <nav class="navbar navbar-expand-lg mentor-navbar">

        <div class="container">

            <!-- Logo -->

            <a class="navbar-brand mentor-logo"
               asp-controller="Home"
               asp-action="Index">

                <span class="logo-icon">
                    M
                </span>

                <span>
                    Mentor<span class="logo-highlight">App</span>
                </span>

            </a>


            <!-- Mobile Button -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- Navigation -->

            <div class="collapse navbar-collapse"
                 id="mainNavbar">

                <ul class="navbar-nav mx-auto">

                    <li class="nav-item">

                        <a class="nav-link active"
                           asp-controller="Home"
                           asp-action="Index">

                            Home

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Mentor"
                           asp-action="Index">

                            Find Mentor

                        </a>

                    </li>


                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Appointment"
                           asp-action="Index">

                            Appointments

                        </a>

                    </li>

                </ul>


                <!-- Right Menu -->

                <div class="d-flex align-items-center gap-2">

                    <!-- Notification -->

                    <button class="btn notification-btn">

                        <i class="bi bi-bell"></i>

                        <span class="notification-dot"></span>

                    </button>


                    <!-- Profile -->

                    <div class="dropdown">

                        <button class="btn profile-menu dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown">

                            <span class="user-avatar">
                                SU
                            </span>

                            <span class="d-none d-lg-inline">
                                Suthahar
                            </span>

                        </button>


                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Profile"
                                   asp-action="Index">

                                    <i class="bi bi-person me-2"></i>

                                    My Profile

                                </a>

                            </li>


                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Profile"
                                   asp-action="Edit">

                                    <i class="bi bi-pencil me-2"></i>

                                    Edit Profile

                                </a>

                            </li>


                            <li>

                                <a class="dropdown-item"
                                   asp-controller="Mentor"
                                   asp-action="BecomeMentor">

                                    <i class="bi bi-person-plus me-2"></i>

                                    Become a Mentor

                                </a>

                            </li>


                            <li>
                                <hr class="dropdown-divider">
                            </li>


                            <li>

                                <a class="dropdown-item text-danger"
                                   asp-controller="Account"
                                   asp-action="Logout">

                                    <i class="bi bi-box-arrow-right me-2"></i>

                                    Logout

                                </a>

                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>

    </nav>


    <!-- Main Content -->

    <main>

        @RenderBody()

    </main>


    <!-- Footer -->

    <footer class="mentor-footer">

        <div class="container">

            <div class="row gy-4">

                <div class="col-lg-5">

                    <div class="footer-logo">

                        <span class="logo-icon">
                            M
                        </span>

                        MentorApp

                    </div>

                    <p class="footer-description">

                        Connect with experienced mentors,
                        share knowledge, and grow your career.

                    </p>

                </div>


                <div class="col-lg-2">

                    <h6>
                        Platform
                    </h6>

                    <a href="#">
                        Find Mentor
                    </a>

                    <a href="#">
                        Appointments
                    </a>

                    <a href="#">
                        Become a Mentor
                    </a>

                </div>


                <div class="col-lg-2">

                    <h6>
                        Account
                    </h6>

                    <a href="#">
                        Profile
                    </a>

                    <a href="#">
                        Settings
                    </a>

                    <a href="#">
                        Help
                    </a>

                </div>


                <div class="col-lg-3">

                    <h6>
                        Follow Us
                    </h6>

                    <div class="social-links">

                        <a href="#">
                            <i class="bi bi-linkedin"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-twitter-x"></i>
                        </a>

                    </div>

                </div>

            </div>


            <hr />


            <div class="footer-bottom">

                <span>
                    © 2026 MentorApp. All rights reserved.
                </span>

                <div>

                    <a href="#">
                        Privacy
                    </a>

                    <a href="#">
                        Terms
                    </a>

                </div>

            </div>

        </div>

    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>