@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->

<section class="home-hero">

    <div class="container">

        <div class="row align-items-center">

            <!-- Left -->

            <div class="col-lg-7">

                <span class="welcome-badge">

                    <i class="bi bi-stars"></i>

                    Learn • Connect • Grow

                </span>


                <h1>

                    Find the right

                    <span>mentor</span>

                    for your journey.

                </h1>


                <p class="hero-description">

                    Connect with experienced professionals,
                    get personalized guidance, and take your
                    career to the next level.

                </p>


                <!-- Search -->

                <div class="mentor-search">

                    <div class="search-icon">

                        <i class="bi bi-search"></i>

                    </div>


                    <input type="text"
                           placeholder="Search mentors, skills or technologies..." />


                    <button>

                        Search

                    </button>

                </div>


                <!-- Popular Search -->

                <div class="popular-search">

                    <span>
                        Popular:
                    </span>

                    <a href="#">
                        C#
                    </a>

                    <a href="#">
                        .NET
                    </a>

                    <a href="#">
                        Azure
                    </a>

                    <a href="#">
                        SQL
                    </a>

                    <a href="#">
                        Python
                    </a>

                </div>

            </div>


            <!-- Right -->

            <div class="col-lg-5">

                <div class="hero-visual">

                    <div class="hero-circle">

                        <i class="bi bi-person-workspace"></i>

                    </div>


                    <!-- Floating Card -->

                    <div class="floating-card card-one">

                        <div class="floating-icon">
                            <i class="bi bi-people"></i>
                        </div>

                        <div>

                            <strong>
                                500+
                            </strong>

                            <small>
                                Expert Mentors
                            </small>

                        </div>

                    </div>


                    <div class="floating-card card-two">

                        <div class="floating-icon">

                            <i class="bi bi-star-fill"></i>

                        </div>

                        <div>

                            <strong>
                                4.9/5
                            </strong>

                            <small>
                                Average Rating
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Popular Skills -->

<section class="skills-section">

    <div class="container">

        <div class="section-heading">

            <div>

                <span>
                    EXPLORE
                </span>

                <h2>
                    Popular Skills
                </h2>

            </div>

            <a href="#"
               class="view-all">

                View all
                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <div class="row g-3">

            <div class="col-6 col-md-4 col-lg-2">

                <a href="#"
                   class="skill-card">

                    <i class="bi bi-code-slash"></i>

                    <strong>
                        C#
                    </strong>

                    <small>
                        120 Mentors
                    </small>

                </a>

            </div>


            <div class="col-6 col-md-4 col-lg-2">

                <a href="#"
                   class="skill-card">

                    <i class="bi bi-window"></i>

                    <strong>
                        .NET
                    </strong>

                    <small>
                        98 Mentors
                    </small>

                </a>

            </div>


            <div class="col-6 col-md-4 col-lg-2">

                <a href="#"
                   class="skill-card">

                    <i class="bi bi-cloud"></i>

                    <strong>
                        Azure
                    </strong>

                    <small>
                        86 Mentors
                    </small>

                </a>

            </div>


            <div class="col-6 col-md-4 col-lg-2">

                <a href="#"
                   class="skill-card">

                    <i class="bi bi-database"></i>

                    <strong>
                        SQL
                    </strong>

                    <small>
                        75 Mentors
                    </small>

                </a>

            </div>


            <div class="col-6 col-md-4 col-lg-2">

                <a href="#"
                   class="skill-card">

                    <i class="bi bi-filetype-py"></i>

                    <strong>
                        Python
                    </strong>

                    <small>
                        72 Mentors
                    </small>

                </a>

            </div>


            <div class="col-6 col-md-4 col-lg-2">

                <a href="#"
                   class="skill-card">

                    <i class="bi bi-braces"></i>

                    <strong>
                        Angular
                    </strong>

                    <small>
                        64 Mentors
                    </small>

                </a>

            </div>

        </div>

    </div>

</section>


<!-- Recommended Mentors -->

<section class="mentor-section">

    <div class="container">

        <div class="section-heading">

            <div>

                <span>
                    DISCOVER
                </span>

                <h2>
                    Recommended Mentors
                </h2>

                <p>
                    Learn from professionals who have been there.
                </p>

            </div>

            <a asp-controller="Mentor"
               asp-action="Index"
               class="view-all">

                View all mentors

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        <div class="row g-4">

            <!-- Mentor 1 -->

            <div class="col-md-6 col-lg-4">

                <div class="mentor-card">

                    <div class="mentor-card-top">

                        <div class="mentor-avatar avatar-blue">
                            JS
                        </div>

                        <span class="online-status">
                            <i class="bi bi-circle-fill"></i>
                            Available
                        </span>

                    </div>


                    <h4>
                        John Smith
                    </h4>

                    <p class="mentor-title">
                        Senior .NET Developer
                    </p>


                    <div class="mentor-rating">

                        <i class="bi bi-star-fill"></i>

                        <strong>
                            4.9
                        </strong>

                        <span>
                            (42 reviews)
                        </span>

                    </div>


                    <p class="mentor-experience">

                        <i class="bi bi-briefcase"></i>

                        10 Years Experience

                    </p>


                    <div class="mentor-skills">

                        <span>
                            C#
                        </span>

                        <span>
                            .NET
                        </span>

                        <span>
                            Azure
                        </span>

                        <span>
                            SQL
                        </span>

                    </div>


                    <div class="mentor-card-footer">

                        <span class="mentor-price">

                            <strong>
                                Free
                            </strong>

                            <small>
                                / session
                            </small>

                        </span>


                        <a asp-controller="Mentor"
                           asp-action="Details"
                           class="btn-view">

                            View Profile

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>

                </div>

            </div>


            <!-- Mentor 2 -->

            <div class="col-md-6 col-lg-4">

                <div class="mentor-card">

                    <div class="mentor-card-top">

                        <div class="mentor-avatar avatar-purple">
                            DK
                        </div>

                        <span class="online-status">
                            <i class="bi bi-circle-fill"></i>
                            Available
                        </span>

                    </div>


                    <h4>
                        David Kumar
                    </h4>

                    <p class="mentor-title">
                        Azure Cloud Architect
                    </p>


                    <div class="mentor-rating">

                        <i class="bi bi-star-fill"></i>

                        <strong>
                            4.8
                        </strong>

                        <span>
                            (36 reviews)
                        </span>

                    </div>


                    <p class="mentor-experience">

                        <i class="bi bi-briefcase"></i>

                        12 Years Experience

                    </p>


                    <div class="mentor-skills">

                        <span>
                            Azure
                        </span>

                        <span>
                            Cloud
                        </span>

                        <span>
                            DevOps
                        </span>

                    </div>


                    <div class="mentor-card-footer">

                        <span class="mentor-price">

                            <strong>
                                Free
                            </strong>

                            <small>
                                / session
                            </small>

                        </span>


                        <a asp-controller="Mentor"
                           asp-action="Details"
                           class="btn-view">

                            View Profile

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>

                </div>

            </div>


            <!-- Mentor 3 -->

            <div class="col-md-6 col-lg-4">

                <div class="mentor-card">

                    <div class="mentor-card-top">

                        <div class="mentor-avatar avatar-green">
                            AM
                        </div>

                        <span class="online-status">
                            <i class="bi bi-circle-fill"></i>
                            Available
                        </span>

                    </div>


                    <h4>
                        Alex Martin
                    </h4>

                    <p class="mentor-title">
                        Full Stack Developer
                    </p>


                    <div class="mentor-rating">

                        <i class="bi bi-star-fill"></i>

                        <strong>
                            4.9
                        </strong>

                        <span>
                            (51 reviews)
                        </span>

                    </div>


                    <p class="mentor-experience">

                        <i class="bi bi-briefcase"></i>

                        8 Years Experience

                    </p>


                    <div class="mentor-skills">

                        <span>
                            React
                        </span>

                        <span>
                            Node.js
                        </span>

                        <span>
                            JavaScript
                        </span>

                    </div>


                    <div class="mentor-card-footer">

                        <span class="mentor-price">

                            <strong>
                                Free
                            </strong>

                            <small>
                                / session
                            </small>

                        </span>


                        <a asp-controller="Mentor"
                           asp-action="Details"
                           class="btn-view">

                            View Profile

                            <i class="bi bi-arrow-right"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Become Mentor -->

<section class="become-section">

    <div class="container">

        <div class="become-card">

            <div>

                <span class="become-icon">

                    <i class="bi bi-person-workspace"></i>

                </span>

            </div>


            <div class="flex-grow-1">

                <h2>
                    Share your knowledge.
                    Become a mentor.
                </h2>

                <p>
                    Help others grow while building meaningful
                    professional connections.
                </p>

            </div>


            <div>

                <a asp-controller="Mentor"
                   asp-action="BecomeMentor"
                   class="btn-become">

                    Become a Mentor

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

        </div>

    </div>

</section>